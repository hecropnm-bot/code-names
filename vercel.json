{
  "version": 2,
  "routes": [
    {
      "src": "/styles.css",
      "headers": {
        "Content-Type": "text/css; charset=utf-8"
      },
      "dest": "/styles.css"
    },
    {
      "src": "/script.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8"
      },
      "dest": "/script.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(rooms|game|rules|teams|lamma)(/.*)?",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
